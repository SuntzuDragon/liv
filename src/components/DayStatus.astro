---
interface Props {
  /** ISO date of the port day, local to the island. */
  date: string;
  /** Rendered before JS runs, and for anyone without it. */
  fallback: string;
}
const { date, fallback } = Astro.props;
---

<p class="when" data-when={date}>{fallback}</p>

<script is:inline>
  // The page is static and cached for days, so "today" has to be decided on her
  // phone, in her timezone, every time she opens it.
  (() => {
    const el = document.querySelector('[data-when]');
    if (!el) return;
      // The itinerary is written in local port time, so the current day is
      // decided in Greece - not in whatever timezone the reader happens to be
      // in. Without this, viewing from the US shows the wrong day entirely.
      // (Greece is UTC+3 vs Italy's UTC+2, so on the Italian days the badge
      // flips an hour early. Far better than being a whole day out.)
      const cruiseToday = () => {
        try {
          const parts = new Intl.DateTimeFormat('en-US', {
            timeZone: 'Europe/Athens',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          }).formatToParts(new Date());
          const get = (t) => parts.find((p) => p.type === t).value;
          return get('year') + '-' + get('month') + '-' + get('day');
        } catch {
          const n = new Date();
          const p = (v) => String(v).padStart(2, '0');
          return n.getFullYear() + '-' + p(n.getMonth() + 1) + '-' + p(n.getDate());
        }
      };

    const render = () => {
      const target = new Date(el.dataset.when + 'T00:00:00Z');
      const today = new Date(cruiseToday() + 'T00:00:00Z');
      const days = Math.round((target - today) / 86400000);

    const label =
      days === 0 ? 'Today - you’re here' :
      days === 1 ? 'Tomorrow' :
      days === -1 ? 'That was yesterday' :
      days > 1 ? `In ${days} days` :
      `${Math.abs(days)} days ago`;

    el.textContent = label;
    el.classList.toggle('when--now', days === 0);
    el.classList.toggle('when--past', days < 0);
    };

    render();
    addEventListener('pageshow', render);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) render();
    });
  })();
</script>

<style>
  .when {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.25rem 0.8rem;
    border-radius: var(--r-pill);
    background: oklch(100% 0 0 / 0.2);
    box-shadow: inset 0 0 0 1.5px oklch(100% 0 0 / 0.4);
    color: var(--c-white);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .when--now {
    background: var(--c-sun);
    box-shadow: none;
    color: oklch(32% 0.1 60);
  }
  .when--past {
    opacity: 0.6;
  }
</style>
