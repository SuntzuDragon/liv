---
import PlaceCard from './PlaceCard.astro';
import type { Place } from '../data/types';

interface Props {
  places: Place[];
}
const { places } = Astro.props;
---

<ul class="grid">
  {places.map((p, i) => (
    <li style={`--reveal-delay:${Math.min(i, 5) * 55}ms;`} data-reveal>
      <PlaceCard place={p} i={i} />
    </li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--sp-lg) var(--sp-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grid > li {
    /* Cards lean; the extra inline padding stops a tilted corner clipping. */
    padding-inline: 2px;
    /* Per card, not per section: Safari skips paint for the ones off-screen and
       can release their decoded photos, which is what stops it dropping images
       it then never re-decodes. `auto` means the real height is remembered after
       first render, so scrolling stays stable. */
    content-visibility: auto;
    contain-intrinsic-size: auto 26rem;
  }
</style>
