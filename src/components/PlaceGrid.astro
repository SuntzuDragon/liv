---
import PlaceCard from './PlaceCard.astro';
import type { Place } from '../data/types';

interface Props {
  places: Place[];
}
const { places } = Astro.props;
---

<ul class="grid">
  {places.map((p, i) => (
    <li style={`--reveal-delay:${Math.min(i, 5) * 55}ms;`} data-reveal>
      <PlaceCard place={p} i={i} />
    </li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--sp-lg) var(--sp-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grid > li {
    /* Cards lean; the extra inline padding stops a tilted corner clipping. */
    padding-inline: 2px;
    /* Deliberately NO content-visibility here. It estimates each card's height
       until first paint, so a jump from the section nav to a heading far down
       the page lands in the wrong place. The thumbnails are 440px, roughly
       0.6MB decoded each, so the memory it would save isn't worth a broken
       anchor. loading="lazy" still keeps the live decoded set small. */
  }
</style>
