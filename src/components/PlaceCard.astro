---
import { Image } from 'astro:assets';
import type { Place } from '../data/types';
import { mapLink, googleMaps } from '../lib/maps';
import { photo } from '../lib/photos';

interface Props {
  place: Place;
  /** Index in the grid - drives which way the photo leans. */
  i?: number;
}

const { place: p, i = 0 } = Astro.props;
const img = photo(p.id);
const maps = mapLink(p.name, p.coords, p.placeId);
const kindLabel: Record<Place['kind'], string> = {
  view: 'View',
  church: 'Church',
  museum: 'Museum',
  shop: 'Shop',
  food: 'Food',
  cafe: 'Coffee',
  winery: 'Wine',
};
// Alternate the lean so a grid reads as a hand-pinned collage.
const lean = i % 2 === 0 ? 1 : -1;
---

<article class="card" class:list={[{ 'card--star': p.star }]} style={`--lean:${lean};`}>
  {img && (
    /* Three layers on purpose: .tilt rotates, .frame clips, the img is plain.
       Safari loses a border-radius when the clipping box itself is transformed,
       and rotated text goes soft - so only the photo leans, never the copy. */
    <div class="card__tilt">
      <div class="card__frame">
        <Image
          src={img}
          alt={p.imageAlt ?? p.name}
          widths={[220, 340, 440]}
          sizes="(min-width: 900px) 320px, (min-width: 600px) 44vw, 86vw"
          width={440}
          height={330}
          loading="lazy"
          decoding="async"
          class="card__img"
        />
        <span class="card__kind">{kindLabel[p.kind]}</span>
      </div>
    </div>
  )}

  <div class="card__body">
    <h3 class="card__name">
      {p.name}
      {p.star && <span class="card__star" aria-label="Don't miss">★</span>}
    </h3>
    {p.greek && <p class="card__greek" lang="el">{p.greek}</p>}

    <p class="card__blurb">{p.blurb}</p>

    {(p.hours || p.price || p.tags?.length) && (
      <ul class="chips">
        {p.hours && <li class="chip chip--time">{p.hours}</li>}
        {p.price && <li class="chip chip--price">{p.price}</li>}
        {p.tags?.map((t) => <li class="chip">{t}</li>)}
      </ul>
    )}

    {p.unverified && (
      <p class="card__hedge">Couldn’t confirm this one - worth a look as you pass.</p>
    )}

    <div class="card__actions">
      {maps && (
        <a class="btn btn--map" href={maps} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15">
            <path
              d="M12 2.6a6.6 6.6 0 0 0-6.6 6.6c0 4.8 6.6 12.2 6.6 12.2s6.6-7.4 6.6-12.2A6.6 6.6 0 0 0 12 2.6Zm0 9.3a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Z"
              fill="currentColor"
            />
          </svg>
          Maps
        </a>
      )}
      {p.url && (
        <a class="btn btn--ghost" href={p.url} target="_blank" rel="noopener">Site</a>
      )}
      {p.coords && (
        <a class="btn btn--quiet" href={googleMaps(p.coords)} target="_blank" rel="noopener">
          <span class="visually-hidden">Open in Google Maps</span>
          <span aria-hidden="true">G</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-card);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-md);
    /* clip, not hidden: it makes no scroll container, so it can't break an
       ancestor's position: sticky. */
    overflow: clip;
    transition:
      translate var(--t-mid) var(--ease-out),
      box-shadow var(--t-mid) var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover { translate: 0 -5px; box-shadow: var(--sh-lift); }
  }
  .card--star {
    box-shadow: 0 0 0 2px var(--c-sun), var(--sh-md);
  }

  /* The only thing that rotates - a photo pinned on slightly askew. Inset far
     enough that the rotated corners stay inside the card and nothing clips. */
  .card__tilt {
    margin: 0.7rem 0.7rem 0;
    rotate: calc(var(--lean, 1) * 1.4deg);
    transition: rotate var(--t-mid) var(--ease-spring);
  }
  @media (hover: hover) {
    /* Straightens up when she reaches for it. */
    .card:hover .card__tilt { rotate: 0deg; }
  }

  .card__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: clip;
    border-radius: var(--r-sm);
    background: var(--bg-sunk);
    isolation: isolate;
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* No will-change, no translateZ, no filter: each promoted layer is its own
       device-pixel surface, and there are dozens of these on a page. */
  }

  .card__kind {
    position: absolute;
    inset-block-end: var(--sp-xs);
    inset-inline-start: var(--sp-xs);
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-pill);
    /* Opaque rather than blurred - a backdrop-filter over a photo is the most
       expensive thing you can put on a card you then have forty of. */
    background: oklch(100% 0 0 / 0.93);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-dome-deep);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    padding: var(--sp-md);
    padding-block-start: var(--sp-sm);
    flex: 1;
  }

  .card__name {
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .card__star {
    color: var(--c-sun);
    font-size: 0.8em;
    margin-inline-start: 0.15em;
  }
  .card__greek {
    margin-block-start: -0.3rem;
    font-size: var(--step--1);
    color: var(--fg-soft);
    opacity: 0.8;
  }
  .card__blurb {
    font-size: var(--step-0);
    color: var(--fg-soft);
    line-height: 1.52;
  }
  .card__hedge {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--fg-soft);
    opacity: 0.75;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin-block-start: var(--sp-2xs);
  }
  .chip {
    padding: 0.2rem 0.55rem;
    border-radius: var(--r-pill);
    background: var(--bg-sunk);
    font-size: 0.74rem;
    font-weight: 550;
    color: var(--fg-soft);
  }
  .chip--time {
    background: oklch(87% 0.062 225 / 0.55);
    color: var(--c-aegean);
  }
  .chip--price {
    background: oklch(82% 0.135 72 / 0.32);
    color: oklch(42% 0.11 60);
  }

  .card__actions {
    display: flex;
    gap: 0.5rem;
    margin-block-start: auto;
    padding-block-start: var(--sp-xs);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    /* 44px is Apple's own minimum touch target. */
    min-height: 44px;
    min-width: 44px;
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-pill);
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color var(--t-fast) var(--ease-out),
      scale var(--t-fast) var(--ease-spring);
  }
  .btn:active { scale: 0.96; }
  .btn--map { background: var(--c-dome); color: var(--c-white); }
  .btn--map:hover { background: var(--c-dome-deep); color: var(--c-white); }
  .btn--ghost {
    box-shadow: inset 0 0 0 1.5px var(--line);
    color: var(--fg-soft);
  }
  .btn--ghost:hover { background: var(--bg-sunk); color: var(--fg); }
  /* Secondary, for a non-Apple phone - Apple's web Maps won't hand off there. */
  .btn--quiet {
    padding-inline: 0.5rem;
    color: oklch(62% 0.02 255);
    font-weight: 700;
  }
  .btn--quiet:hover { background: var(--bg-sunk); color: var(--fg-soft); }
</style>
