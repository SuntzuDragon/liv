---
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot__inner">
    <p class="foot__mark">Made for Liv 🤍</p>
    <p class="foot__note">
      Saved to your phone. Works with no signal once you've opened it.
    </p>
    <p class="foot__links">
      <a href="/">All islands</a>
      <span aria-hidden="true">·</span>
      <a href="/credits">Photo credits</a>
      <span aria-hidden="true">·</span>
      <span>{year}</span>
    </p>
  </div>
</footer>

<style>
  .foot {
    padding-block: var(--sp-xl);
    padding-block-end: max(var(--sp-xl), env(safe-area-inset-bottom));
    background: var(--c-aegean);
    color: oklch(100% 0 0 / 0.78);
  }
  .foot__inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2xs);
    align-items: center;
    text-align: center;
  }
  .foot__mark {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--c-white);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }
  .foot__note {
    font-size: var(--step--1);
    max-width: 34ch;
  }
  .foot__links {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.74rem;
    opacity: 0.72;
  }
  .foot__links a { color: inherit; }
</style>
