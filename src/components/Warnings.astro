---
interface Props {
  items: { title: string; body: string }[];
}
const { items } = Astro.props;
---

<ul class="warns">
  {items.map((w, i) => (
    <li class="warn" style={`--reveal-delay:${i * 50}ms;`} data-reveal>
      <span class="warn__n" aria-hidden="true">{i + 1}</span>
      <div>
        <h3 class="warn__title">{w.title}</h3>
        <p class="warn__body">{w.body}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .warns {
    display: grid;
    gap: var(--sp-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .warn {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    gap: var(--sp-md);
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: oklch(72% 0.165 45 / 0.07);
    box-shadow: inset 3px 0 0 var(--c-sunset);
  }
  .warn__n {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--c-sunset);
    color: var(--c-white);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
  }
  .warn__title {
    font-size: var(--step-1);
    line-height: 1.2;
    margin-block-end: 0.25rem;
    color: oklch(40% 0.13 42);
  }
  .warn__body {
    font-size: var(--step-0);
    color: var(--fg-soft);
    line-height: 1.55;
  }
</style>
