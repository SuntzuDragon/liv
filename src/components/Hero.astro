---
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos';

interface Props {
  eyebrow?: string;
  title: string;
  /** Rendered slightly rotated and in the sun colour, like a scribbled aside. */
  accent?: string;
  lede?: string;
  imageId?: string;
  alt?: string;
  /** Renders a back chip over the hero. The sticky nav sits below the fold. */
  backHref?: string;
  backLabel?: string;
}

const { eyebrow, title, accent, lede, imageId, alt = '', backHref, backLabel = 'All islands' } =
  Astro.props;
const img = imageId ? photo(imageId) : undefined;
---

<header class="hero" class:list={[{ 'hero--plain': !img }]}>
  {img && (
    <div class="hero__media">
      <Picture
        src={img}
        alt={alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 960, 1440]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>
  )}

  {backHref && (
    <a class="hero__back" href={backHref}>
      <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15">
        <path
          d="M15.5 4.5 8 12l7.5 7.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      {backLabel}
    </a>
  )}

  <div class="hero__inner wrap">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">
      {title}
      {accent && <em class="hero__accent">{accent}</em>}
    </h1>
    {lede && <p class="hero__lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 40rem);
    padding-block: var(--sp-2xl) var(--sp-xl);
    padding-block-start: max(var(--sp-2xl), env(safe-area-inset-top));
    overflow: clip;
    isolation: isolate;
    color: var(--c-white);
  }
  .hero--plain {
    min-height: auto;
    color: var(--fg);
    background:
      radial-gradient(
        120% 90% at 15% -10%,
        oklch(87% 0.062 225 / 0.75),
        transparent 60%
      ),
      radial-gradient(
        90% 80% at 95% 0%,
        oklch(82% 0.135 72 / 0.42),
        transparent 55%
      );
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  /* <Picture> wraps the img in a <picture>, which is inline and auto-height by
     default — so height:100% on the img resolved against nothing and the hero
     stopped being filled. The wrapper has to carry the box. */
  .hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Deliberately static. This used to drift via an infinite animation on
       scale + object-position; object-position is not compositor-friendly, so
       it repainted a full-screen image every frame and made scrolling judder
       on iOS for as long as the hero was on screen. */
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      oklch(22% 0.06 254 / 0.84) 0%,
      oklch(24% 0.06 254 / 0.44) 38%,
      oklch(30% 0.06 254 / 0.08) 68%,
      transparent 100%
    );
  }

  /* Not sticky or fixed: an element pinned to the top edge would recolour
     Safari's toolbar to its own background on iOS 26+. */
  .hero__back {
    position: absolute;
    inset-block-start: max(var(--sp-md), calc(env(safe-area-inset-top) + 0.5rem));
    inset-inline-start: var(--gutter);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    padding-inline: 0.6rem 0.85rem;
    border-radius: var(--r-pill);
    background: oklch(22% 0.05 254 / 0.55);
    box-shadow: inset 0 0 0 1px oklch(100% 0 0 / 0.25);
    color: var(--c-white);
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease-out), scale var(--t-fast) var(--ease-spring);
  }
  .hero__back:active { scale: 0.95; }
  .hero__back:hover { background: oklch(22% 0.05 254 / 0.78); color: var(--c-white); }
  .hero--plain .hero__back {
    background: var(--bg-sunk);
    box-shadow: none;
    color: var(--c-dome-deep);
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .hero__eyebrow {
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--c-sun);
  }
  .hero--plain .hero__eyebrow { color: var(--accent-warm); }

  .hero__title {
    font-size: var(--step-6);
    font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 120;
    letter-spacing: -0.028em;
    max-width: 24ch;
  }
  .hero__accent {
    display: block;
    font-style: normal;
    font-size: 0.62em;
    color: var(--c-sun);
    rotate: -1.4deg;
    transform-origin: left center;
    margin-block-start: 0.12em;
  }
  .hero--plain .hero__accent { color: var(--accent-warm); }

  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 44ch;
    color: oklch(100% 0 0 / 0.92);
  }
  .hero--plain .hero__lede { color: var(--fg-soft); }
</style>
