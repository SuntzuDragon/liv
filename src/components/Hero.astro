---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';

interface Props {
  eyebrow?: string;
  title: string;
  /** Rendered slightly rotated and in the sun colour, like a scribbled aside. */
  accent?: string;
  lede?: string;
  imageId?: string;
  alt?: string;
}

const { eyebrow, title, accent, lede, imageId, alt = '' } = Astro.props;
const img = imageId ? photo(imageId) : undefined;
---

<header class="hero" class:list={[{ 'hero--plain': !img }]}>
  {img && (
    <div class="hero__media">
      <Image
        src={img}
        alt={alt}
        widths={[640, 960, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="hero__img"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>
  )}

  <div class="hero__inner wrap">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">
      {title}
      {accent && <em class="hero__accent">{accent}</em>}
    </h1>
    {lede && <p class="hero__lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 40rem);
    padding-block: var(--sp-2xl) var(--sp-xl);
    padding-block-start: max(var(--sp-2xl), env(safe-area-inset-top));
    overflow: clip;
    isolation: isolate;
    color: var(--c-white);
  }
  .hero--plain {
    min-height: auto;
    color: var(--fg);
    background:
      radial-gradient(
        120% 90% at 15% -10%,
        oklch(87% 0.062 225 / 0.75),
        transparent 60%
      ),
      radial-gradient(
        90% 80% at 95% 0%,
        oklch(82% 0.135 72 / 0.42),
        transparent 55%
      );
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* A slow drift so the hero is never quite static. */
    animation: drift 34s var(--ease-out) infinite alternate;
  }
  @keyframes drift {
    from { scale: 1.06; object-position: 48% 50%; }
    to   { scale: 1.14; object-position: 54% 44%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__img { animation: none; scale: 1.02; }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      oklch(22% 0.06 254 / 0.84) 0%,
      oklch(24% 0.06 254 / 0.44) 38%,
      oklch(30% 0.06 254 / 0.08) 68%,
      transparent 100%
    );
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .hero__eyebrow {
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--c-sun);
  }
  .hero--plain .hero__eyebrow { color: var(--accent-warm); }

  .hero__title {
    font-size: var(--step-6);
    font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 120;
    letter-spacing: -0.028em;
    max-width: 24ch;
  }
  .hero__accent {
    display: block;
    font-style: normal;
    font-size: 0.62em;
    color: var(--c-sun);
    rotate: -1.4deg;
    transform-origin: left center;
    margin-block-start: 0.12em;
  }
  .hero--plain .hero__accent { color: var(--accent-warm); }

  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 44ch;
    color: oklch(100% 0 0 / 0.92);
  }
  .hero--plain .hero__lede { color: var(--fg-soft); }
</style>
