---
interface Props {
  /** In document order - the scrollspy relies on it. */
  items: { id: string; label: string }[];
  /** Where the back arrow goes. */
  home?: string;
  homeLabel?: string;
}
const { items, home = '/', homeLabel = 'Islands' } = Astro.props;
---

<nav class="snav" aria-label="Sections">
  <a class="snav__home" href={home}>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
      <path
        d="M15.5 4.5 8 12l7.5 7.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span>{homeLabel}</span>
  </a>

  <ul class="snav__list">
    {items.map((it) => (
      <li>
        <a class="snav__pill" href={`#${it.id}`} data-spy={it.id}>{it.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script is:inline>
  // Deferred: this component renders above <main>, so the sections it watches
  // do not exist yet while the parser is here.
  (() => {
    const start = () => {
      const strip = document.querySelector('.snav__list');
      const pills = [...document.querySelectorAll('[data-spy]')];
      if (!strip || !pills.length) return;

      const byId = new Map(pills.map((p) => [p.dataset.spy, p]));
      const targets = [...byId.keys()]
        .map((id) => document.getElementById(id))
        .filter(Boolean);
      if (!targets.length) return;

      let current = null;

      /**
       * Scrolls the pill strip only - never the page.
       *
       * This used to call pill.scrollIntoView({block:'nearest'}), which on iOS
       * Safari also moves the document and yanks you mid-scroll. Setting
       * scrollLeft directly cannot touch the page, and it is skipped entirely
       * while the pill is already comfortably in view.
       */
      const keepPillVisible = (pill) => {
        const pad = 24;
        const left = pill.offsetLeft;
        const right = left + pill.offsetWidth;
        const viewLeft = strip.scrollLeft;
        const viewRight = viewLeft + strip.clientWidth;
        if (left >= viewLeft + pad && right <= viewRight - pad) return;
        strip.scrollLeft = left - strip.clientWidth / 2 + pill.offsetWidth / 2;
      };

      const apply = (id) => {
        if (id === current) return;
        current = id;
        for (const [pid, pill] of byId) {
          const on = pid === id;
          pill.classList.toggle('is-active', on);
          if (on) pill.setAttribute('aria-current', 'true');
          else pill.removeAttribute('aria-current');
        }
        const pill = byId.get(id);
        if (pill) keepPillVisible(pill);
      };

      // "Which section owns the top of the screen" - measured against a line a
      // little below the nav, so a section jumped to by anchor reads as current.
      const compute = () => {
        const line = Math.max(140, innerHeight * 0.3);
        let best = targets[0].id;
        for (const t of targets) {
          if (t.getBoundingClientRect().top <= line) best = t.id;
        }
        apply(best);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          compute();
        });
      };

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      compute();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>

<style>
  .snav {
    position: sticky;
    inset-block-start: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding-block: 0.5rem;
    padding-block-start: max(0.5rem, env(safe-area-inset-top));
    padding-inline-start: var(--gutter);
    /* Deliberately opaque and deliberately the page background. A translucent
       backdrop-filter here would tear during iOS rubber-band overscroll AND
       hijack the Liquid Glass toolbar tint; matching --bg makes the tint
       correct either way. */
    background-color: var(--bg);
    border-block-end: 1px solid var(--line);
  }

  /* Outside the scrolling strip, so it is always reachable. */
  .snav__home {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    flex: none;
    min-height: 44px;
    padding-inline: 0.55rem 0.7rem;
    border-radius: var(--r-pill);
    background: var(--bg-sunk);
    color: var(--c-dome-deep);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease-out), scale var(--t-fast) var(--ease-spring);
  }
  .snav__home:active { scale: 0.95; }
  .snav__home:hover { background: var(--c-sky); color: var(--c-aegean); }

  .snav__list {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    /* Longhands, not `margin: 0` plus an override - the minifier collapses that
       pair back to `margin: 0` and the gap disappears. */
    margin-block: 0;
    margin-inline: 0.35rem 0;
    /* The divider lives on the scroller's own edge, so it always sits exactly
       where the pills begin regardless of how wide the home button renders. */
    border-inline-start: 1px solid var(--line);
    padding-inline: 0.6rem var(--gutter);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    /* No scroll-snap: on iOS it fights momentum and makes programmatic
       scrollLeft adjustments visibly lurch. */
  }
  .snav__list::-webkit-scrollbar { display: none; }

  .snav__pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.3rem 0.95rem;
    border-radius: var(--r-pill);
    font-size: var(--step--1);
    font-weight: 650;
    white-space: nowrap;
    text-decoration: none;
    color: var(--fg-soft);
    background: transparent;
    transition:
      background-color var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out);
  }
  .snav__pill:hover { background: var(--bg-sunk); color: var(--fg); }
  .snav__pill:active { background: var(--bg-sunk); }
  .snav__pill.is-active {
    background: var(--c-dome);
    color: var(--c-white);
  }

  @media (max-width: 24rem) {
    .snav__home span { display: none; }
    .snav__home { padding-inline: 0.5rem; }
  }
</style>
