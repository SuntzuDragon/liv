---
import type { Phrase } from '../data/types';

interface Props {
  phrases: Phrase[];
}
const { phrases } = Astro.props;
---

<ul class="phrases">
  {phrases.map((p, i) => (
    <li class="phrase" style={`--reveal-delay:${i * 45}ms;`} data-reveal>
      <span class="phrase__greek" lang="el">{p.greek}</span>
      <span class="phrase__say">{p.say}</span>
      <span class="phrase__means">{p.means}</span>
    </li>
  ))}
</ul>

<style>
  .phrases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--sp-sm);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .phrase {
    display: grid;
    gap: 0.12rem;
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: linear-gradient(
      165deg,
      oklch(87% 0.062 225 / 0.3),
      oklch(100% 0 0) 62%
    );
    box-shadow: var(--sh-sm);
  }

  .phrase__greek {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--c-dome-deep);
    line-height: 1.2;
  }
  /* The bit she'll actually read out loud. */
  .phrase__say {
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--fg);
  }
  .phrase__means {
    font-size: var(--step--1);
    color: var(--fg-soft);
  }
</style>
