---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionNav from '../components/SectionNav.astro';
import Section from '../components/Section.astro';
import FactStrip from '../components/FactStrip.astro';
import PlaceGrid from '../components/PlaceGrid.astro';
import PhraseList from '../components/PhraseList.astro';
import PinList from '../components/PinList.astro';
import DayStatus from '../components/DayStatus.astro';
import Footer from '../components/Footer.astro';
import { FACTS, PHRASES, SPECIALITIES, SUNSET } from '../data/santorini-essentials';
import { OIA, AMMOUDI, FIRA, BEYOND } from '../data/santorini-places';
import { TRANSPORT } from '../data/santorini-transport';

const nav = [
  { id: 'day', label: 'The day' },
  { id: 'pins', label: 'Pins' },
  { id: 'oia', label: 'Oia' },
  { id: 'fira', label: 'Fira' },
  { id: 'know', label: 'Know this' },
  { id: 'greek', label: 'Greek' },
];

const byKind = (places: typeof OIA, kinds: Place['kind'][]) =>
  places.filter((p) => kinds.includes(p.kind));
type Place = (typeof OIA)[number];
---

<Base
  title="Santorini - Liv's Islands"
  description="Oia and Fira in one day. The views, the shops worth going into, and where to eat. Wednesday 21 October 2026."
  themeColor="#0d3a5c"
  ogImage="/icon-512.png"
>
  <Hero
    backHref="/"
    eyebrow="Wednesday 21 October · 07:00 - 22:00"
    title="Santorini"
    accent="fifteen hours"
    lede={`Long enough to do Oia properly, come back for Fira, and still be sitting on a wall at ${SUNSET} when the sun goes down. Most ships sail way before that. Yours doesn't.`}
    imageId="santorini-hero"
    alt="White houses stepping down the caldera cliff at Oia, a windmill above them"
  >
    <DayStatus date="2026-10-21" fallback="Wednesday 21 October" />
  </Hero>

  <SectionNav items={nav} />

  <main id="main">
    <Section
      id="day"
      eyebrow="At a glance"
      title="The numbers that matter"
    >
      <FactStrip facts={FACTS} />

</Section>

    <Section
      id="pins"
      tone="sunk"
      eyebrow="Save these"
      title="Pins worth having"
      lede="Tap one and it opens in Apple Maps. Works with no signal once you've opened this page."
    >
      <PinList pins={TRANSPORT} />
    </Section>

    <Section
      id="oia"
      eyebrow="Morning"
      title="Oia"
      lede="Less busy earlier in the day."
    >
      {OIA.length > 0 ? (
        <>
          <h3 class="sub">Sights and views</h3>
          <PlaceGrid places={byKind(OIA, ['view', 'church', 'museum'])} />
          <h3 class="sub">Shops</h3>
          <PlaceGrid places={byKind(OIA, ['shop'])} />
          <h3 class="sub">Food and coffee</h3>
          <PlaceGrid places={byKind(OIA, ['food', 'cafe'])} />
          {AMMOUDI.length > 0 && (
            <>
              <h3 class="sub">Down at Ammoudi Bay</h3>
              <p class="sub__note">
                About 280 steps below the village - 10-15 minutes down, 20-30 back
                up with no shade. Kinda steep.
              </p>
              <PlaceGrid places={AMMOUDI} />
            </>
          )}
        </>
      ) : (
        <p class="pending">Still being filled in.</p>
      )}
    </Section>

    <Section
      id="fira"
      tone="sky"
      eyebrow="Afternoon"
      title="Fira"
      lede="More shade, more shops, more places to eat."
    >
      {FIRA.length > 0 ? (
        <>
          <h3 class="sub">Sights and museums</h3>
          <PlaceGrid places={byKind(FIRA, ['view', 'church', 'museum'])} />
          <h3 class="sub">Shops</h3>
          <PlaceGrid places={byKind(FIRA, ['shop'])} />
          <h3 class="sub">Food and coffee</h3>
          <PlaceGrid places={byKind(FIRA, ['food', 'cafe'])} />
          {BEYOND.length > 0 && (
            <>
              <h3 class="sub">Worth the trip out</h3>
              <PlaceGrid places={BEYOND} />
            </>
          )}
        </>
      ) : (
        <p class="pending">Still being filled in.</p>
      )}
    </Section>

    <Section
      id="know"
      tone="sunk"
      eyebrow="Worth knowing"
      title="A few small things"
    >
      <div class="prose stack" data-reveal>
        <ul class="plain">
          <li>
            <strong>You can probs stay for sunset.</strong> It's at {SUNSET} and
            the ship doesn't sail until 22:00 (verify this).
            Oia is the famous spot and it gets packed. The Fira caldera edge is
            less busy.
          </li>
          <li>
            <strong>Sun.</strong> 22°C feels mild but the UV is 5, and every wall
            and paving slab on the island is white. People burn here in October
            exactly because the air feels cool. Sunscreen - reapply!
          </li>
          <li>
            <strong>Water.</strong> Tap water is desalinated and tastes it. Buy
            bottled, or fill up on the ship before you go.
          </li>
          <li>
            <strong>Cards.</strong> Apple Pay works essentially everywhere -
            card terminals are legally mandatory in Greek retail now.
          </li>
          <li>
            <strong>Tipping.</strong> Not expected. Rounding up, or 5-10% for good
            table service, is plenty.
          </li>
        </ul>
      </div>
    </Section>

    <Section
      id="greek"
      eyebrow="Useful"
      title="Enough Greek to be polite"
      lede="Click the speaker icon to hear the pronunciation."
    >
      <PhraseList phrases={PHRASES} />

      <h3 class="sub">Order these</h3>
      <ul class="specs">
        {SPECIALITIES.map((s, i) => (
          <li class="spec" style={`--reveal-delay:${i * 45}ms;`} data-reveal>
            <h4 class="spec__name">
              {s.name}
              {s.greek && <span class="spec__greek" lang="el">{s.greek}</span>}
            </h4>
            <p class="spec__what">{s.what}</p>
          </li>
        ))}
      </ul>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .prose { max-width: var(--measure); }
  .prose h3 {
    font-size: var(--step-2);
    margin-block-start: var(--sp-lg);
  }
  .prose h3:first-child { margin-block-start: 0; }
  .prose p { color: var(--fg-soft); }
  .prose strong { color: var(--fg); font-weight: 650; }

  .plain {
    display: grid;
    gap: var(--sp-sm);
    padding: 0;
    list-style: none;
  }
  .plain li {
    padding-inline-start: var(--sp-md);
    border-inline-start: 2px solid var(--line);
    color: var(--fg-soft);
  }
  .plain strong { color: var(--fg); }

  .plan {
    max-width: var(--measure);
    margin-block: var(--sp-xl) var(--sp-lg);
  }
  .plan__h { font-size: var(--step-2); margin-block-end: var(--sp-xs); }
  .plan__p { color: var(--fg-soft); }

  .sub {
    margin-block: var(--sp-xl) var(--sp-md);
    font-size: var(--step-2);
  }
  .sub__note {
    max-width: var(--measure);
    margin-block-end: var(--sp-md);
    color: var(--fg-soft);
    font-size: var(--step-0);
  }
  .pending { color: var(--fg-soft); font-style: italic; }

  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--sp-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .spec {
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: var(--bg-card);
    box-shadow: var(--sh-sm);
  }
  .spec__name {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-size: var(--step-1);
    margin-block-end: 0.3rem;
  }
  .spec__greek {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--fg-soft);
    opacity: 0.75;
  }
  .spec__what {
    font-size: var(--step-0);
    color: var(--fg-soft);
    line-height: 1.5;
  }
</style>
