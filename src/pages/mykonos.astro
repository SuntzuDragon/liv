---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionNav from '../components/SectionNav.astro';
import Section from '../components/Section.astro';
import FactStrip from '../components/FactStrip.astro';
import PlaceGrid from '../components/PlaceGrid.astro';
import PinList from '../components/PinList.astro';
import PhraseList from '../components/PhraseList.astro';
import DayStatus from '../components/DayStatus.astro';
import Footer from '../components/Footer.astro';
import { FACTS, SPECIALITIES, SUNSET } from '../data/mykonos-essentials';
import { PHRASES } from '../data/santorini-essentials';
import { MYKONOS_SIGHTS, MYKONOS_FOOD, MYKONOS_PINS } from '../data/mykonos-places';

const nav = [
  { id: 'day', label: 'The day' },
  { id: 'pins', label: 'Pins' },
  { id: 'see', label: 'See' },
  { id: 'eat', label: 'Eat' },
  { id: 'know', label: 'Know this' },
  { id: 'greek', label: 'Greek' },
];

const sights = MYKONOS_SIGHTS.filter((p) => p.kind !== 'shop');
const shops = MYKONOS_SIGHTS.filter((p) => p.kind === 'shop');
---

<Base
  title="Mykonos - Liv's Islands"
  description="One day in Mykonos Town on foot. The windmills, Little Venice, the alleys, and where to eat. Thursday 22 October 2026."
  themeColor="#0d3a5c"
>
  <Hero
    backHref="/"
    eyebrow="Thursday 22 October · ashore 09:00, last tender 16:30"
    title="Mykonos"
    accent="all within 400 meters"
    lede="You land in the middle of the thing you came to see. No bus, no shuttle, no transfer. Every famous sight is a five minute walk from the water."
    imageId="mykonos-hero"
    alt="The row of windmills at Kato Mili above Mykonos Town"
  >
    <DayStatus date="2026-10-22" fallback="Thursday 22 October" />
  </Hero>

  <SectionNav items={nav} />

  <main id="main">
    <Section
      id="day"
      eyebrow="At a glance"
      title="The numbers that matter"
      lede="A shorter day than Santorini, and the whole town is walkable."
    >
      <FactStrip facts={FACTS} />

</Section>

    <Section
      id="pins"
      tone="sunk"
      eyebrow="Save these"
      title="Pins worth having"
      lede="Everything is a few minutes' walk from the water. Tap one and it opens in Apple Maps."
    >
      <PinList pins={MYKONOS_PINS} />
    </Section>

    <Section
      id="see"
      eyebrow="Morning"
      title="What to actually see"
      lede="All of it inside a four-hundred-meter circle, which is why the day works at all."
    >
      <PlaceGrid places={sights} />
      <h3 class="sub">Worth going into</h3>
      <PlaceGrid places={shops} />
    </Section>

    <Section
      id="eat"
      tone="sky"
      eyebrow="Midday"
      title="Where to eat"
      lede="Most of the famous places here open at 19:00, so they're useless to you. These are open while you're ashore."
    >
      <PlaceGrid places={MYKONOS_FOOD} />

      <h3 class="sub">Order these</h3>
      <ul class="specs">
        {SPECIALITIES.map((s, i) => (
          <li class="spec" style={`--reveal-delay:${i * 45}ms;`} data-reveal>
            <h4 class="spec__name">
              {s.name}
              {s.greek && <span class="spec__greek" lang="el">{s.greek}</span>}
            </h4>
            <p class="spec__what">{s.what}</p>
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="know"
      tone="sunk"
      eyebrow="Worth knowing"
      title="A few small things"
    >
      <div class="prose stack" data-reveal>
        <ul class="plain">
          <li>
            <strong>Sunset is {SUNSET}</strong>, which is after you sail.
          </li>
          <li>
            <strong>Last tender back is 16:30.</strong> The shops shut at 14:30
            and reopen at 18:30, long after you have gone. The Maritime Museum
            closes at 15:00, the Archaeological Museum at 16:00.
          </li>
          <li>
            <strong>Water.</strong> The tap water isn't drinkable here.
          </li>
          <li>
            <strong>There's no good bookshop</strong> in Mykonos Town.
          </li>
          <li>
            <strong>Most "best of Mykonos" lists are dinner only.</strong> To
            Maereio, m-eating and Kalita all open at 19:00, after you sail.
          </li>
          <li>
            <strong>Most shops and restaurants</strong> stay open through October.
            Some won't be.
          </li>
        </ul>
        <p><a class="xlink" href="/santorini">The Santorini page &rarr;</a></p>
      </div>
    </Section>

    <Section
      id="greek"
      eyebrow="Useful"
      title="Enough Greek to be polite"
      lede="The middle line is the one to say out loud."
    >
      <PhraseList phrases={PHRASES} />
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .prose { max-width: var(--measure); }
  .prose h3 { font-size: var(--step-2); margin-block-start: var(--sp-lg); }
  .prose h3:first-child { margin-block-start: 0; }
  .prose p { color: var(--fg-soft); }
  .prose strong { color: var(--fg); font-weight: 650; }

  .plain { display: grid; gap: var(--sp-sm); padding: 0; list-style: none; }
  .plain li {
    padding-inline-start: var(--sp-md);
    border-inline-start: 2px solid var(--line);
    color: var(--fg-soft);
  }
  .plain strong { color: var(--fg); }

  .plan { max-width: var(--measure); margin-block: var(--sp-xl) var(--sp-lg); }
  .plan__h { font-size: var(--step-2); margin-block-end: var(--sp-xs); }
  .plan__p { color: var(--fg-soft); }

  .sub { margin-block: var(--sp-xl) var(--sp-md); font-size: var(--step-2); }

  .xlink { font-weight: 700; text-decoration: none; }

  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--sp-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .spec {
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: var(--bg-card);
    box-shadow: var(--sh-sm);
  }
  .spec__name {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-size: var(--step-1);
    margin-block-end: 0.3rem;
  }
  .spec__greek {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--fg-soft);
    opacity: 0.75;
  }
  .spec__what { font-size: var(--step-0); color: var(--fg-soft); line-height: 1.5; }
</style>
