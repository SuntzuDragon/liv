---
import Base from '../layouts/Base.astro';
---

<Base title="Not here - Liv's Islands" description="That page doesn't exist.">
  <main id="main" class="nf">
    <div class="nf__box">
      <p class="nf__num">404</p>
      <h1 class="nf__title">Nothing here</h1>
      <p class="nf__body">
        Wrong turn - which, to be fair, is the correct way to experience a Greek island.
      </p>
      <a class="nf__home" href="/">Back to the islands &rarr;</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--gutter);
    background:
      radial-gradient(120% 80% at 50% 0%, oklch(87% 0.062 225 / 0.6), transparent 65%),
      var(--bg);
  }
  .nf__box {
    max-width: 30rem;
    padding: var(--sp-xl) var(--sp-lg);
    border-radius: var(--r-xl);
    background: var(--bg-card);
    box-shadow: var(--sh-lg);
    rotate: -0.8deg;
    text-align: center;
  }
  .nf__num {
    font-family: var(--font-display);
    font-size: var(--step-6);
    font-weight: 600;
    line-height: 1;
    color: var(--c-sky);
    font-variation-settings: 'SOFT' 60, 'WONK' 1;
  }
  .nf__title { margin-block: var(--sp-xs) var(--sp-sm); }
  .nf__body { color: var(--fg-soft); margin-block-end: var(--sp-lg); }
  .nf__home { font-weight: 700; text-decoration: none; color: var(--c-dome-deep); }
</style>
