/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Workers static assets default to `max-age=0, must-revalidate` and do NOT
# give hashed filenames a long cache on their own.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be served stale, or she gets stuck on an old
# precache manifest.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
